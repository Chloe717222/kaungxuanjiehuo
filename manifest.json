{
  "manifest_version": 3,
  "name": "框选解惑",
  "version": "1.0",
  "author": "Huan",
  "description": "有疑惑，用框选解惑。框选任意文字，AI 用大白话帮你理解，支持追问和保存到 Obsidian。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.deepseek.com/*",
    "https://api.openai.com/*",
    "http://127.0.0.1:*/*",
    "https://127.0.0.1:*/*",
    "http://localhost:*/*",
    "https://localhost:*/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>", "file:///*"],
      "js": ["content.js"]
    }
  ],
  "commands": {
    "open-chat": {
      "suggested_key": {
        "default": "Ctrl+Q",
        "mac": "MacCtrl+Q"
      },
      "description": "打开 AI 对话窗口"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "框选解惑 · AI 对话",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["<all_urls>", "file:///*"]
    }
  ]
}
